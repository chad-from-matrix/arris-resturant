{
  "name": "arris",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project arris-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=arris-test tsx scripts/seed.ts --with-admin --force && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=arris-test tsx scripts/seed-test-users.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "jsqr": "^1.4.0",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.5.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "15.5.25",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^13.35.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
