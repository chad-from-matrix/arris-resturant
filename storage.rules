rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // exists() must gate get() — see the note in firestore.rules.
    function staffPath() {
      return /databases/(default)/documents/staff/$(request.auth.uid);
    }
    function role() {
      return request.auth != null
        && firestore.exists(staffPath())
        && firestore.get(staffPath()).data.active == true
        ? firestore.get(staffPath()).data.role
        : 'none';
    }
    function isManagerUp() {
      return role() in ['super_admin', 'manager'];
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    // Logo, hero and food photos are shown on the public site.
    match /brand/{file} {
      allow read: if true;
      allow write: if isManagerUp() && isImage();
    }
    match /menu-items/{file} {
      allow read: if true;
      allow write: if isManagerUp() && isImage();
    }
    match /categories/{file} {
      allow read: if true;
      allow write: if isManagerUp() && isImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
