rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function staffDoc() {
      return firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data;
    }
    function isStaffMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && staffDoc().active == true;
    }
    function isManagerUp() {
      return isStaffMember() && staffDoc().role in ['super_admin', 'manager'];
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    // Logo, hero and food photos are shown on the public site.
    match /brand/{file} {
      allow read: if true;
      allow write: if isManagerUp() && isImage();
    }
    match /menu-items/{file} {
      allow read: if true;
      allow write: if isManagerUp() && isImage();
    }
    match /categories/{file} {
      allow read: if true;
      allow write: if isManagerUp() && isImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
